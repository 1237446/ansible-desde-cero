FROM ubuntu:latest

ENV DEBIAN_FRONTEND=noninteractive

# 1. Instalar systemd, openssh-server, sudo y limpiar
RUN apt-get update && apt-get install -y \
    systemd \
    systemd-sysv \
    openssh-server \
    sudo && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# 2. Crear el usuario ansible y darle permisos de sudo
RUN useradd -m -s /bin/bash ansible && \
    echo "ansible:password" | chpasswd && \
    usermod -aG sudo ansible

# 3. Preparar la carpeta .ssh
RUN mkdir -p /home/ansible/.ssh && \
    chmod 700 /home/ansible/.ssh && \
    chown -R ansible:ansible /home/ansible

# 4. Configurar SSH
RUN ssh-keygen -A && \
    sed -i 's/#PasswordAuthentication yes/PasswordAuthentication yes/' /etc/ssh/sshd_config

# 5. Habilitar SSH mediante Systemd (¡Aquí está la magia!)
RUN systemctl enable ssh

EXPOSE 22

# 6. Definir systemd como el proceso principal
CMD ["/lib/systemd/systemd"]
